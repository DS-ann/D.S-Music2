<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_aura"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.34"
        android:background="@drawable/widget_background"
        android:clipToOutline="true"
        android:scaleType="centerCrop"
        android:visibility="visible" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_scrim" />

    <ImageView
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:alpha="0.92"
        android:contentDescription="D.S Music"
        android:src="@drawable/ic_launcher_foreground" />

    <ImageView
        android:id="@+id/widget_album_art"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="10dp"
        android:background="@drawable/shape_album_art_round"
        android:clipToOutline="true"
        android:scaleType="centerCrop"
        android:src="@drawable/default_album_art" />

    <ViewFlipper
        android:id="@+id/widget_flipper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toEndOf="@id/widget_album_art"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="44dp"
        android:autoStart="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NOW PLAYING"
                android:textColor="#BFD0EE"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/widget_song_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:gravity="start"
                android:maxLines="1"
                android:text="Song Title"
                android:textColor="@color/widget_on_background"
                android:textSize="17sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/widget_artist_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:alpha="0.82"
                android:ellipsize="end"
                android:gravity="start"
                android:maxLines="1"
                android:text="Artist Name"
                android:textColor="@color/widget_on_background"
                android:textSize="12sp"
                android:includeFontPadding="false" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/widget_prev"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/widget_control_background"
                    android:contentDescription="Previous"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_skip_previous" />

                <ImageButton
                    android:id="@+id/widget_play_pause"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/widget_control_background"
                    android:contentDescription="Play or Pause"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_play" />

                <ImageButton
                    android:id="@+id/widget_next"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/widget_control_background"
                    android:contentDescription="Next"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_skip_next" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LIVE LYRICS"
                android:textColor="#BFD0EE"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/widget_lyrics_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:fontFamily="sans"
                android:gravity="start|center_vertical"
                android:includeFontPadding="false"
                android:lineSpacingExtra="2dp"
                android:maxLines="3"
                android:text="..."
                android:textColor="@color/widget_on_background"
                android:textSize="19sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ViewFlipper>

    <ProgressBar
        android:id="@+id/widget_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="8dp"
        android:progress="0"
        android:progressDrawable="@drawable/widget_progress_bar" />

    <ImageButton
        android:id="@+id/widget_toggle_lyrics"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="7dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/widget_control_background"
        android:contentDescription="Toggle lyrics"
        android:padding="10dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_lyrics" />
</RelativeLayout>
