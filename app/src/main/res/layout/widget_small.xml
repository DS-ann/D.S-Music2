<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_aura"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.18"
        android:scaleType="centerCrop"
        android:background="@android:color/transparent"
        android:visibility="visible" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="7dp"
        android:paddingEnd="8dp"
        android:paddingBottom="7dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_album_art"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/shape_album_art_round"
                android:clipToOutline="true"
                android:scaleType="centerCrop"
                android:src="@drawable/default_album_art" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="D.S MUSIC"
                    android:textColor="#C9D8F5"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:includeFontPadding="false" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Now Playing"
                    android:textColor="@color/widget_on_background"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Choose a song"
                    android:textColor="@color/widget_on_background"
                    android:alpha="0.78"
                    android:textSize="10sp"
                    android:includeFontPadding="false" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/widget_prev"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/widget_control_background"
                android:contentDescription="Previous"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_skip_previous"
                android:tint="@android:color/white" />

            <ImageButton
                android:id="@+id/widget_play_pause"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="7dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/widget_control_background"
                android:contentDescription="Play or Pause"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_play"
                android:tint="@android:color/white" />

            <ImageButton
                android:id="@+id/widget_next"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/widget_control_background"
                android:contentDescription="Next"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_skip_next"
                android:tint="@android:color/white" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/widget_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="9dp"
        android:layout_marginEnd="9dp"
        android:progress="0"
        android:progressDrawable="@drawable/widget_progress_bar" />
</FrameLayout>
